#!/bin/sh
# Valida el formato del asunto: "tipo: qué cambió".
# Tipos: datos, codigo, historia, opencode, docs, estructura.

msg_file="$1"
first_line=$(head -n 1 "$msg_file")

# Permitir merge y revert sin validar.
case "$first_line" in
    "Merge "*|"Revert "*) exit 0 ;;
esac

pattern='^(datos|codigo|historia|opencode|docs|estructura): .+'
if ! printf '%s\n' "$first_line" | grep -Eq "$pattern"; then
    echo "commit-msg: asunto inválido." >&2
    echo "  Esperado: tipo: qué cambió" >&2
    echo "  Tipos: datos, codigo, historia, opencode, docs, estructura" >&2
    echo "  Recibido: $first_line" >&2
    exit 1
fi

exit 0
